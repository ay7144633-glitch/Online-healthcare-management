<%@ include file="shell-top.jspf" %>
<div class="page-heading"><div><div class="eyebrow"><span class="eyebrow-dot"></span>DOCTOR AVAILABILITY</div><h1>Publish open times</h1><p>Patients can request an appointment only during a time you publish.</p></div></div>
<section class="panel"><div class="panel-heading"><div><h2>Add availability</h2><p>Pick a date and set when you are free to see patients.</p></div></div>
    <form class="form-grid availability-form" method="post" action="${ctx}/actions/availability/save" data-availability-form><input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}' />"><input type="hidden" name="returnTo" value="/doctor/schedule">
        <label>Date<input type="date" name="availableDate" min="<c:out value='${minimumAvailabilityDate}' />" required></label>
        <div class="availability-time-fields field-wide"><label>Start time<input type="time" name="availableStart" step="1800" required></label><label>End time<input type="time" name="availableEnd" step="1800" required></label></div>
        <div class="availability-presets field-wide"><span class="availability-presets-label">Quick fill</span><button class="button button-secondary button-small" type="button" data-start="09:00" data-end="12:00">Morning</button><button class="button button-secondary button-small" type="button" data-start="13:00" data-end="17:00">Afternoon</button><button class="button button-secondary button-small" type="button" data-start="09:00" data-end="17:00">Full day</button></div>
        <p class="availability-help field-wide">Availability must be in the future and last at least 30 minutes.</p>
        <div class="form-actions field-wide"><button class="button button-primary" type="submit">Publish availability <span aria-hidden="true">&#8594;</span></button></div>
    </form>
</section>
<section class="panel"><div class="panel-heading"><div><h2>Upcoming appointments</h2><p>Your next 7 days of patient visits.</p></div><a class="text-link" href="${ctx}/appointments">Full appointment list <span aria-hidden="true">&#8594;</span></a></div>
    <div class="appointment-week" aria-label="Upcoming appointment calendar"><c:forEach var="day" items="${appointmentDays}"><article class="appointment-day"><div class="appointment-day-heading"><strong><c:out value="${day.date().getDayOfWeek().toString().substring(0, 3)}" /></strong><span><c:out value="${day.date()}" /></span></div><c:choose><c:when test="${empty day.appointments()}"><p class="appointment-day-empty">No visits</p></c:when><c:otherwise><div class="appointment-day-list"><c:forEach var="visit" items="${day.appointments()}"><div class="appointment-day-visit"><strong><c:out value="${visit.appointmentAt().toLocalTime()}" /></strong><span><c:out value="${visit.patientName()}" /></span><small class="status status-${visit.status().toLowerCase()}"><c:out value="${visit.status().toLowerCase()}" /></small></div></c:forEach></div></c:otherwise></c:choose></article></c:forEach></div>
</section>
<section class="panel"><div class="panel-heading"><div><h2>Published times</h2><p>Open appointment windows currently visible to patients.</p></div></div>
    <c:choose><c:when test="${empty availability}"><div class="empty-state"><strong>No open times published</strong>Add a future time window so patients can request appointments.</div></c:when><c:otherwise><div class="table-wrap"><table class="data-table"><thead><tr><th>Available from</th><th>Available until</th><th>Action</th></tr></thead><tbody><c:forEach var="block" items="${availability}"><tr><td><strong><c:out value="${block.availableFrom().toLocalDate()}" /></strong><small><c:out value="${block.availableFrom().toLocalTime()}" /></small></td><td><strong><c:out value="${block.availableTo().toLocalDate()}" /></strong><small><c:out value="${block.availableTo().toLocalTime()}" /></small></td><td><form method="post" action="${ctx}/actions/availability/delete"><input type="hidden" name="csrfToken" value="<c:out value='${sessionScope.csrfToken}' />"><input type="hidden" name="returnTo" value="/doctor/schedule"><input type="hidden" name="availabilityId" value="${block.id()}"><button class="button button-danger button-small" type="submit">Remove</button></form></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose>
</section>
<script src="${ctx}/assets/availability.js" defer></script>
<%@ include file="shell-bottom.jspf" %>